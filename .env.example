# Copy to .env for local development. Never commit .env.
DEBUG=True
SECRET_KEY=replace-with-a-new-local-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
# Optional: set DATABASE_URL for PostgreSQL, or DB_ENGINE=mysql and DB_* values.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DB_ENGINE=mysql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306
TIME_ZONE=UTC
# Optional S3-compatible durable media storage:
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=

# Official social destinations (configure only links owned/approved by the publisher).
SOCIAL_FACEBOOK_URL=
SOCIAL_X_URL=
SOCIAL_INSTAGRAM_URL=
# Use a wa.me direct chat link or an official WhatsApp channel/community URL.
SOCIAL_WHATSAPP_URL=
